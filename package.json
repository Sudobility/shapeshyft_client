{
  "name": "@sudobility/shapeshyft_client",
  "version": "0.0.115",
  "description": "React client library for ShapeShyft API with TanStack Query hooks",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "build:watch": "bunx tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "bunx eslint src --ext .ts,.tsx",
    "lint:fix": "bunx eslint src --ext .ts,.tsx --fix",
    "format": "bunx prettier --write src/**/*.ts",
    "format:check": "bunx prettier --check src/**/*.ts",
    "typecheck": "bunx tsc --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build"
  },
  "keywords": [
    "shapeshyft",
    "llm",
    "api-client",
    "react",
    "tanstack-query",
    "typescript"
  ],
  "author": "John Huang",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/shapeshyft_types": "^1.1.19",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@sudobility/di": "^1.5.81",
    "@sudobility/shapeshyft_types": "^1.1.19",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": "~5.104.5",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "jsdom": "~30.1.3",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "typescript": "~6.0.3",
    "vitest": "~4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/shapeshyft_client.git"
  }
}
